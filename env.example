# Copiá estas variables en Vercel: Project > Settings > Environment Variables.
# NUNCA las subas a GitHub con valores reales (este archivo es solo un molde).

# --- Mercado Pago ---
# Access Token de la aplicación (Tus integraciones > tu app > Credenciales). Empieza con APP_USR-
MP_ACCESS_TOKEN=APP_USR-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Clave secreta del webhook (Tus integraciones > tu app > Webhooks > Configurar notificaciones)
MP_WEBHOOK_SECRET=
# "true" = rechaza notificaciones con firma inválida. Dejalo vacío hasta confirmar en la prueba
# "Simular" que tus firmas validan (ver README, sección "Firma del webhook").
MP_WEBHOOK_STRICT=

# --- URLs ---
# Dominio donde vive el SITIO (donde está pago.html), sin barra final.
SITE_URL=https://mollicaemoka.store
# Dominio donde vive el BACKEND (/api/...). Si el sitio entero está en Vercel, dejalo vacío.
# Si el sitio sigue en otro hosting y solo el backend está en Vercel: https://tu-proyecto.vercel.app
API_URL=https://REEMPLAZAR-CON-TU-URL.vercel.app

# --- Google Sheets ---
GOOGLE_SERVICE_ACCOUNT_EMAIL=nombre@proyecto.iam.gserviceaccount.com
# Pegá la private_key del JSON tal cual, entre comillas, con los \n literales.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEET_ID=
